# Application
APP_NAME=EcoOps AI
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload limits
MAX_UPLOAD_SIZE_BYTES=1048576
ALLOWED_UPLOAD_EXTENSIONS=.yaml,.yml

# Database (PostgreSQL for local/docker; use sqlite:///:memory: for tests)
DATABASE_URL=postgresql+psycopg://ecoops:ecoops@localhost:5432/ecoops
