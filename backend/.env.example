# Application
APP_NAME=EcoOps AI
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload limits
MAX_UPLOAD_SIZE_BYTES=1048576
ALLOWED_UPLOAD_EXTENSIONS=.yaml,.yml

# Database (PostgreSQL for local/docker; use sqlite:///:memory: for tests)
DATABASE_URL=postgresql+psycopg://ecoops:ecoops@localhost:5432/ecoops

# Phase 5 artifacts; run `python ml/train_model.py` from the repository root first.
MODEL_DIR=../ml/models

# Phase 7 prototype estimation assumptions. These are transparent estimates, not provider bills or measurements.
ESTIMATION_PERIOD_HOURS=730
CPU_COST_PER_VCPU_HOUR_USD=0.04
MEMORY_COST_PER_GB_HOUR_USD=0.005
CPU_POWER_WATTS_PER_ACTIVE_VCPU=15.0
MEMORY_POWER_WATTS_PER_ACTIVE_GB=0.5
DATA_CENTER_PUE=1.4
CARBON_INTENSITY_GCO2_PER_KWH=430.0
